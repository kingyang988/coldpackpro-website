      <div class="prose prose-slate max-w-none">
        
        <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 bg-white text-slate-800 antialiased">
  <header class="mb-8 pb-8 border-b border-slate-200">
